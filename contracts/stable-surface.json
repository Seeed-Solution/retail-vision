 "python": {
  "apps.ConfigApp": {
   "analyzers": "(self, spec: 'StreamSpec') -> 'list[dict]'",
   "configure": "(self, options: 'dict', device_id: 'str') -> 'None'",
   "event_payload": "(self, ev: 'Event') -> 'dict'",
   "frame_payload": "(self, res: 'FrameResult', attr_names: 'tuple[str, ...]' = ()) -> 'dict'",
   "on_event": "(self, ctx: 'StreamContext', ev: 'Event') -> 'list[Outgoing]'",
   "on_frame": "(self, ctx: 'StreamContext', res: 'FrameResult') -> 'list[Outgoing]'",
   "on_stream_added": "(self, ctx: 'StreamContext') -> 'None'",
   "on_stream_removed": "(self, ctx: 'StreamContext') -> 'None'",
   "plugins": "(self) -> 'list[str]'"
  },
  "embed.Runtime": {
   "add_stream": "(self, stream_id: 'str', url: 'str', *, analyzers: 'list[dict] | None' = None, options: 'dict | None' = None, name: 'str' = '', transport: 'str' = 'tcp', score_threshold: 'float | None' = None, timeout_s: 'float' = 10.0) -> 'dict'",
   "configure_analyzer": "(self, stream_id: 'str', name: 'str', config: 'dict', timeout_s: 'float' = 3.0) -> 'dict'",
   "remove_stream": "(self, stream_id: 'str', timeout_s: 'float' = 5.0) -> 'None'",
   "results": "(self, timeout_s: 'float | None' = None)",
   "snapshot": "(self, stream_id: 'str', seq: 'int' = 0, track_id: 'int' = 0, max_side: 'int' = 640) -> 'bytes'",
   "start": "(self)",
   "stop": "(self) -> 'None'"
  },
  "geom": {
   "joint_angle_deg": "(a, b, c, src_w: 'int', src_h: 'int') -> 'float'",
   "point_in_polygon": "(x: 'float', y: 'float', polygon: 'list') -> 'bool'",
   "source_boxes": "(res: 'FrameResult')",
   "source_keypoints": "(res: 'FrameResult', det: 'Detection')"
  },
  "hooks.AppHooks": {
   "analyzers": "(self, spec: 'StreamSpec') -> 'list[dict]'",
   "on_event": "(self, ctx: 'StreamContext', ev: 'Event') -> 'list[Outgoing]'",
   "on_frame": "(self, ctx: 'StreamContext', res: 'FrameResult') -> 'list[Outgoing]'",
   "on_stream_added": "(self, ctx: 'StreamContext') -> 'None'",
   "on_stream_removed": "(self, ctx: 'StreamContext') -> 'None'",
   "plugins": "(self) -> 'list[str]'"
  },
  "hooks.Outgoing": "(topic_suffix: 'str', payload: 'dict | bytes', qos: 'int' = 0, retain: 'bool' = False) -> None",
  "hooks.StreamContext": {
   "analyzer_configs": "(self, hooks: \"'AppHooks'\") -> 'list[dict]'",
   "configure_analyzer": "(self, name: 'str', config: 'dict', timeout_s: 'float' = 3.0) -> 'dict'",
   "request_snapshot": "(self, seq: 'int' = 0, track_id: 'int' = 0, crop: 'bool' = True, max_side: 'int' = 640, timeout_s: 'float' = 3.0) -> 'tuple[dict, bytes]'"
  },
  "mqtt": {
   "MqttClient": "(host: 'str', port: 'int' = 1883, client_id: 'str' = '', *, username: 'str' = '', password: 'str' = '', tls: 'bool' = False, ca_file: 'str' = '', cert_file: 'str' = '', key_file: 'str' = '', keepalive_s: 'int' = 30, will: 'Will | None' = None, reconnect_min_s: 'float' = 1.0, reconnect_max_s: 'float' = 60.0, max_inflight: 'int' = 32, on_connect: 'Callable[[], None] | None' = None, on_disconnect: 'Callable[[str], None] | None' = None)",
   "Will": "(topic: 'str', payload: 'bytes', qos: 'int' = 1, retain: 'bool' = True) -> None",
   "topic_matches": "(topic_filter: 'str', topic: 'str') -> 'bool'"
  },
  "mqtt.MqttClient": {
   "close": "(self, timeout_s: 'float' = 2.0) -> 'None'",
   "connect": "(self, timeout_s: 'float' = 10.0) -> 'bool'",
   "publish": "(self, topic: 'str', payload: 'bytes | str', qos: 'int' = 0, retain: 'bool' = False, timeout_s: 'float' = 5.0) -> 'bool'",
   "stats": "(self) -> 'dict'",
   "subscribe": "(self, topic_filter: 'str', qos: 'int', callback: 'Callable[[str, bytes, bool], None]') -> 'None'",
   "unsubscribe": "(self, topic_filter: 'str') -> 'None'"
  }
 },
