  "structs": {
   "vb_analyzer_api": [
    "uint32_t abi",
    "const char* name",
    "uint32_t attr_count",
    "const char* const* attr_names",
    "void* (*create)(const char* config_json, char* err, size_t errlen)",
    "void (*destroy)(void* self)",
    "int (*on_frame)(void* self, const vb_frame_meta* m, const vb_track* tracks, size_t n, float* attrs_out, vb_emit_fn emit, void* sink)",
    "void (*on_track_removed)(void* self, uint32_t track_id, double t_mono_s)"
   ],
   "vb_frame_meta": [
    "uint32_t stream_index",
    "uint64_t seq",
    "double wall_ms, t_mono_s",
