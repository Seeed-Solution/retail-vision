{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vb-command.schema.json",
  "title": "vb.command/1",
  "type": "object",
  "required": ["schema", "device_id", "request_id", "command", "params"],
  "properties": {
    "schema": {"const": "vb.command/1"},
    "timestamp": {"type": "integer"},
    "device_id": {"type": "string"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "command": {"enum": ["add_stream", "remove_stream", "set_threshold", "list_streams"]},
    "params": {
      "type": "object",
      "properties": {
        "stream_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "url": {"type": "string"},
        "name": {"type": "string"},
        "transport": {"enum": ["tcp", "udp"]},
        "score_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "options": {
          "type": "object",
          "properties": {
            "max_fps": {"type": "number", "minimum": 0,
              "description": "finite frames per second; 0 means unlimited"},
            "roi_crop": {
              "oneOf": [
                {"type": "null"},
                {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1},
                 "minItems": 4, "maxItems": 4}
              ]
            }
          }
        }
      }
    }
  }
}
