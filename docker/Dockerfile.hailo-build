# Build-only image. HailoRT headers, the CMake package and libhailort itself are
# bind-mounted from the host at build time rather than installed here, so the
# binary links against exactly the HailoRT the host runs (4.21.0) and cannot
# drift from the kernel driver.
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libmosquitto-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
ENTRYPOINT ["sh", "-c", "mkdir -p /src/build && cmake -S /src -B /tmp/build -DCMAKE_BUILD_TYPE=Release && cmake --build /tmp/build -j2 && cp /tmp/build/retail-vision-hailo /src/build/retail-vision-hailo"]
